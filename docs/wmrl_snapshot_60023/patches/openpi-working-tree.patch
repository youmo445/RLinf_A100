diff --git a/src/openpi/transforms.py b/src/openpi/transforms.py
index 272375e..ed785a8 100644
--- a/src/openpi/transforms.py
+++ b/src/openpi/transforms.py
@@ -191,6 +191,26 @@ class ResizeImages(DataTransformFn):
         return data
 
 
+@dataclasses.dataclass(frozen=True)
+class DirectResizeImages(DataTransformFn):
+    height: int
+    width: int
+    method: jax.image.ResizeMethod = jax.image.ResizeMethod.LINEAR
+
+    def __call__(self, data: DataDict) -> DataDict:
+        def resize(image):
+            image = np.asarray(image)
+            resized = jax.image.resize(image, (self.height, self.width, image.shape[-1]), method=self.method)
+            if image.dtype == np.uint8:
+                return np.round(np.asarray(resized)).clip(0, 255).astype(np.uint8)
+            if np.issubdtype(image.dtype, np.floating):
+                return np.asarray(resized, dtype=image.dtype)
+            raise ValueError(f"Unsupported image dtype: {image.dtype}")
+
+        data["image"] = {k: resize(v) for k, v in data["image"].items()}
+        return data
+
+
